{
  "name": "valixa-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "pnpm --filter @valixa/core --filter @valixa/react --filter @valixa/mui --filter @valixa/vue --filter @valixa/vuetify --filter @valixa/angular --filter @valixa/angular-material --filter @valixa/auto --filter @valixa/devtools --filter @valixa/angular-auto --filter @valixa/angular-devtools -r build",
    "typecheck": "pnpm build && tsc -p tsconfig.json && pnpm --filter @valixa/example-vue typecheck && pnpm --filter @valixa/example-angular typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm example:js && pnpm example:ts",
    "example:js": "node examples/core/login.js",
    "example:ts": "tsx examples/core/login.ts",
    "changeset": "changeset",
    "example:react": "pnpm --filter @valixa/example-react dev",
    "examples:build": "pnpm --filter @valixa/example-react --filter @valixa/example-vue --filter @valixa/example-angular -r build",
    "test:browser": "playwright test",
    "test:packages": "node scripts/check-packages.mjs && node scripts/check-vue-packages.mjs && node scripts/check-angular-packages.mjs && node scripts/check-phase6-packages.mjs && node scripts/check-core-release.mjs",
    "test:packages:vue": "node scripts/check-vue-packages.mjs",
    "example:vue": "pnpm --filter @valixa/example-vue dev",
    "examples:vue:build": "pnpm --filter @valixa/example-vue build",
    "example:angular": "pnpm --filter @valixa/example-angular start",
    "test:angular": "vitest run --config vitest.angular.config.ts",
    "test:packages:angular": "node scripts/check-angular-packages.mjs",
    "test:advanced": "vitest run tests/advanced-core.test.ts tests/react-advanced-core.test.tsx tests/vue-advanced-core.test.ts tests/angular/reactive-engine.test.ts",
    "benchmark": "node --expose-gc --import tsx benchmarks/run.ts",
    "benchmark:compare": "node --expose-gc --import tsx benchmarks/compare.ts",
    "profile:core": "node --expose-gc --import tsx benchmarks/profile.ts --allocations",
    "profile:core:before": "node --expose-gc --import tsx benchmarks/profile.ts --phase5 --allocations",
    "test:performance": "vitest run tests/performance-contracts.test.ts tests/react-advanced-core.test.tsx tests/vue-advanced-core.test.ts tests/angular/reactive-engine.test.ts",
    "test:phase6": "vitest run tests/auto.test.ts tests/react-auto.test.tsx tests/vue-auto.test.ts tests/angular/auto.test.ts tests/devtools.test.ts tests/devtools-panel.test.tsx tests/angular/devtools.test.ts",
    "benchmark:phase6": "node --expose-gc --import tsx benchmarks/phase-6.ts",
    "test:packages:phase6": "node scripts/check-phase6-packages.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:check:candidate": "node scripts/check-release.mjs --candidate",
    "test:browser:release": "playwright test --config playwright.release.config.ts",
    "audit:security": "pnpm audit --audit-level=low",
    "release:verify": "node scripts/verify-release.mjs",
    "benchmark:release": "node --expose-gc --import tsx benchmarks/phase-7-paired.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@mui/material": "~7.3.0",
    "@mui/x-date-pickers": "~8.29.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "dayjs": "^1.11.13",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.0",
    "@valixa/core": "workspace:*",
    "@valixa/react": "workspace:*",
    "@valixa/mui": "workspace:*",
    "vue": "~3.5.0",
    "vuetify": "~3.13.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/server-renderer": "~3.5.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "vue-tsc": "~3.3.14",
    "@valixa/vue": "workspace:*",
    "@valixa/vuetify": "workspace:*",
    "@angular/core": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-server": "~21.2.0",
    "@angular/animations": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/ssr": "~21.2.0",
    "@angular/material": "~21.2.0",
    "@angular/cdk": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "ng-packagr": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "@valixa/angular": "workspace:*",
    "@valixa/angular-material": "workspace:*",
    "@valixa/auto": "workspace:*",
    "@valixa/devtools": "workspace:*",
    "@valixa/angular-auto": "workspace:*",
    "@valixa/angular-devtools": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9 <14.0.2": "14.0.2",
      "minimatch@>=7 <11.0.1": "11.0.1"
    }
  }
}
