{
  "name": "@valixa/devtools",
  "version": "1.0.0-rc.1",
  "type": "module",
  "license": "MIT",
  "description": "Opt-in value-safe inspection and lifecycle tooling",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@valixa/core": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "keywords": [
    "forms",
    "validation",
    "typescript",
    "headless",
    "valixa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Heshammesalam/Valixa.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/Heshammesalam/Valixa#readme",
  "bugs": {
    "url": "https://github.com/Heshammesalam/Valixa/issues"
  }
}
