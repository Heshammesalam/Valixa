{
  "name": "valixa-auto",
  "version": "1.0.0-rc.1",
  "type": "module",
  "license": "MIT",
  "description": "Framework-independent typed Auto Form plans",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "valixa": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "keywords": [
    "forms",
    "validation",
    "typescript",
    "headless",
    "valixa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Heshammesalam/Valixa.git",
    "directory": "packages/auto"
  },
  "homepage": "https://github.com/Heshammesalam/Valixa#readme",
  "bugs": {
    "url": "https://github.com/Heshammesalam/Valixa/issues"
  }
}
