  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/valixa-angular-auto.d.ts",
      "default": "./dist/fesm2022/valixa-angular-auto.mjs"
    }
